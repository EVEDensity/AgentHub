# ───────────────────────────────────────────────────────────────────
# AgentHub Environment Variables
# ───────────────────────────────────────────────────────────────────
# 复制此文件为 .env 并按需修改。所有变量都有合理默认值，不设置也能运行。
# Copy to .env and customize. Everything works with defaults.
# ───────────────────────────────────────────────────────────────────

# ── 基础设施 (Infrastructure) ────────────────────────────────────────
# NATS_URL=nats://127.0.0.1:4222
# REDIS_ADDR=127.0.0.1:6379
# DATABASE_DSN=postgres://agenthub:agenthub@localhost:5432/agenthub?sslmode=disable

# ── 安全 (Security) ──────────────────────────────────────────────────
# JWT 密钥 — 留空则开发模式（不验签），生产环境必须设置 64 字符 hex
# JWT_SECRET=
# KMS 主密钥 — 留空则 KMS 禁用，生产环境必须设置 64 字符 hex
# KMS_MASTER_KEY=

# ── 模型提供商 (Model Providers) ─────────────────────────────────────
# 至少设置一个才能在非 mock 模式下使用 Agent。
# 不设置也可以运行，系统会自动注册 mock 提供商。

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# BGE Embedding (TEI-compatible server)
# BGE_API_URL=http://127.0.0.1:8080
# BGE_API_KEY=

# OpenAI 兼容 (Ollama / LiteLLM / vLLM)
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_API_KEY=not-needed

# ── 前端 (Frontend) ──────────────────────────────────────────────────
# API_BACKEND=go                 # go (默认) 或 legacy
# GO_GATEWAY_URL=http://127.0.0.1:8081
