{
  "react_flow": {
    "states": [
      {"name": "ingest", "owner": "realtime-orchestrator", "output": "normalized_request"},
      {"name": "classify", "owner": "router-agent", "output": "route_decision"},
      {"name": "retrieve", "owner": "search-agent", "output": "retrieval_bundle"},
      {"name": "plan", "owner": "planner-agent", "output": "execution_plan"},
      {"name": "act", "owner": "executor-agent", "output": "runtime_actions"},
      {"name": "observe", "owner": "realtime-orchestrator", "output": "runtime_observations"},
      {"name": "reflect", "owner": "critic-agent", "output": "continuation_advice"},
      {"name": "continue_or_finish", "owner": "realtime-orchestrator", "output": "decision"},
      {"name": "synthesize", "owner": "summarizer-agent", "output": "grounded_answer"},
      {"name": "stream_back", "owner": "stream-delivery-service", "output": "client_delivery"}
    ],
    "budgets": {
      "max_steps": 12,
      "max_online_time_ms": 15000,
      "max_tool_rounds": 4,
      "max_retrieval_rounds": 3
    }
  },
  "deepsearch_flow": {
    "steps": [
      {"name": "query_rewrite", "owner": "realtime-orchestrator"},
      {"name": "multi_hop_decompose", "owner": "search-agent"},
      {"name": "hybrid_retrieve", "owner": "retrieval-core", "sources": ["qdrant", "opensearch"]},
      {"name": "cross_source_merge", "owner": "retrieval-core"},
      {"name": "rerank", "owner": "retrieval-core"},
      {"name": "citation_grounding", "owner": "search-agent"},
      {"name": "answer_synthesis", "owner": "summarizer-agent"}
    ],
    "fallbacks": {
      "rewrite_timeout": "use original query",
      "hybrid_timeout": "dense only",
      "rerank_timeout": "fusion score only",
      "grounding_timeout": "return evidence with confidence warning"
    }
  }
}
