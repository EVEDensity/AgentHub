{
  "targets": {
    "online_connections": 10000,
    "active_sessions": 2000,
    "concurrent_agent_tasks": {
      "min": 500,
      "max": 1000
    },
    "p95_first_token_ms": 2000,
    "p95_gateway_push_ms": 80,
    "delivery_success_ratio": 0.9999
  },
  "controls": {
    "gateway": ["tenant rate limiting", "connection cap per user", "sse downgrade"],
    "stream_core": ["chunk coalescing", "flush window", "slow-client summary mode"],
    "orchestrator": ["react step budget", "tool round cap", "retrieval timeout budget"],
    "runtime": ["pool concurrency ceilings", "circuit breakers", "budget enforcement"]
  },
  "initial_cluster": {
    "gateway_service": {"replicas": "6-10", "cpu": "500m", "memory": "512Mi"},
    "realtime_orchestrator": {"replicas": "4-6", "cpu": "1000m", "memory": "1Gi"},
    "stream_delivery_service": {"replicas": "4-6", "cpu": "500m", "memory": "512Mi"},
    "stream_core": {"replicas": "3-5", "cpu": "1000m", "memory": "1Gi"},
    "retrieval_core": {"replicas": "3-6", "cpu": "1500m", "memory": "2Gi"},
    "python_offline_workers": {"replicas": "4-12", "cpu": "1000m", "memory": "2Gi"},
    "redis_cluster": "3 master + 3 replica",
    "nats_jetstream": "3 nodes",
    "postgresql": "1 primary + 2 read replicas",
    "qdrant": "3 nodes",
    "opensearch": "3 nodes",
    "minio": "4 nodes distributed"
  }
}
