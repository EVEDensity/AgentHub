{
  "phases": [
    {
      "phase": 1,
      "name": "foundation and contracts",
      "duration_weeks": 6,
      "deliverables": [
        "service boundaries finalized",
        "event schemas published",
        "redis/nats/postgresql/qdrant/minio baseline up",
        "go gateway mvp",
        "observability bootstrap"
      ]
    },
    {
      "phase": 2,
      "name": "realtime control plane migration",
      "duration_weeks": 8,
      "deliverables": [
        "go realtime orchestrator online",
        "session state externalized to redis",
        "permission flow migrated",
        "python removed from online critical path"
      ]
    },
    {
      "phase": 3,
      "name": "rust core and deepsearch rollout",
      "duration_weeks": 10,
      "deliverables": [
        "stream-core wired into delivery path",
        "retrieval-core powering fusion and rerank",
        "deepsearch multi-hop flow in production",
        "slow-client backpressure controls enabled"
      ]
    },
    {
      "phase": 4,
      "name": "commercial hardening",
      "duration_weeks": 12,
      "deliverables": [
        "tenant quotas and billing",
        "audit and replay",
        "chaos drills and auto-degrade",
        "10k connection load validation"
      ]
    }
  ],
  "migration_strategy": {
    "style": "dual-run and progressive traffic shifting",
    "steps": [
      "mirror websocket traffic metadata into the new event bus",
      "cut gateway ingress first",
      "move permission and session state second",
      "switch stream delivery third",
      "activate rust retrieval fusion behind feature flags",
      "retire python online orchestration last"
    ]
  }
}
