{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenthub.dev/v1/verification-evaluation-policy.schema.json",
  "title": "Verification evaluation policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "inconclusive"]
    },
    "criterionId": { "$ref": "common.schema.json#/$defs/identifier" },
    "evaluator": {
      "type": "string",
      "enum": ["artifact-set.v1"]
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumArtifacts", "requiredArtifactKinds"],
      "properties": {
        "minimumArtifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "requiredArtifactKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "artifact.schema.json#/properties/kind" }
        }
      }
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "no_applicable_policy",
        "ambiguous_policy",
        "invalid_configuration",
        "unsupported_evaluator",
        "artifact_requirements_not_met"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "criterionId", "evaluator", "configurationDigest", "parameters"
      ],
      "properties": {
        "status": { "const": "ready" }
      },
      "not": { "required": ["reasonCode"] }
    },
    {
      "required": ["reasonCode"],
      "properties": {
        "status": { "const": "inconclusive" }
      },
      "not": {
        "anyOf": [
          { "required": ["criterionId"] },
          { "required": ["evaluator"] },
          { "required": ["configurationDigest"] },
          { "required": ["parameters"] }
        ]
      }
    }
  ]
}
