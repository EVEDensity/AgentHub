{
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "missionId": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Missionid",
      "type": "string"
    },
    "workUnitId": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Workunitid",
      "type": "string"
    },
    "attempt": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "contractId": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Contractid",
      "type": "string"
    },
    "contractVersion": {
      "minimum": 1,
      "title": "Contractversion",
      "type": "integer"
    },
    "configurationDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Configurationdigest",
      "type": "string"
    },
    "executionMode": {
      "const": "trusted-local",
      "title": "Executionmode",
      "type": "string"
    },
    "inputSnapshotDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Inputsnapshotdigest",
      "type": "string"
    },
    "candidateSnapshotDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Candidatesnapshotdigest",
      "type": "string"
    },
    "testProfileDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Testprofiledigest",
      "type": "string"
    },
    "receiptType": {
      "const": "trusted-test-run",
      "title": "Receipttype",
      "type": "string"
    },
    "receiptId": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Receiptid",
      "type": "string"
    },
    "producerId": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Producerid",
      "type": "string"
    },
    "keyId": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Keyid",
      "type": "string"
    },
    "patchDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Patchdigest",
      "type": "string"
    },
    "reportDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Reportdigest",
      "type": "string"
    },
    "logDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Logdigest",
      "type": "string"
    },
    "exitCode": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": -65535,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exitcode"
    },
    "timedOut": {
      "title": "Timedout",
      "type": "boolean"
    },
    "startedAt": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Startedat",
      "type": "string"
    },
    "finishedAt": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Finishedat",
      "type": "string"
    },
    "signature": {
      "maxLength": 88,
      "minLength": 88,
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "missionId",
    "workUnitId",
    "attempt",
    "contractId",
    "contractVersion",
    "configurationDigest",
    "executionMode",
    "inputSnapshotDigest",
    "candidateSnapshotDigest",
    "testProfileDigest",
    "receiptType",
    "receiptId",
    "producerId",
    "keyId",
    "patchDigest",
    "reportDigest",
    "logDigest",
    "exitCode",
    "timedOut",
    "startedAt",
    "finishedAt",
    "signature"
  ],
  "title": "TrustedTestReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenthub.dev/v1/trusted-test-receipt.schema.json"
}
