{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agenthub.dev/v1/verification-work-discovery-response.schema.json",
  "title": "Verification work discovery response",
  "type": "object",
  "additionalProperties": false,
  "required": ["discoveryStatus", "verificationContext"],
  "properties": {
    "discoveryStatus": {
      "type": "string",
      "enum": ["ready", "idle"]
    },
    "verificationContext": {
      "oneOf": [
        { "$ref": "#/$defs/verificationContext" },
        { "type": "null" }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "discoveryStatus": { "const": "ready" },
        "verificationContext": { "$ref": "#/$defs/verificationContext" }
      }
    },
    {
      "properties": {
        "discoveryStatus": { "const": "idle" },
        "verificationContext": { "type": "null" }
      }
    }
  ],
  "$defs": {
    "verificationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "mission", "contract", "workUnit", "artifacts",
        "evaluationPolicy"
      ],
      "properties": {
        "version": { "const": 2 },
        "mission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "objective"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "title": { "type": "string", "minLength": 1, "maxLength": 255 },
            "objective": { "type": "string", "minLength": 1, "maxLength": 10000 }
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "acceptanceCriteria"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "version": { "type": "integer", "minimum": 1 },
            "acceptanceCriteria": {
              "$ref": "mission-contract.schema.json#/properties/acceptanceCriteria"
            }
          }
        },
        "workUnit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "kind", "inputRefs", "expectedOutputs", "status", "attempt"
          ],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "type": "string", "minLength": 1, "maxLength": 255 },
            "inputRefs": { "$ref": "work-unit.schema.json#/properties/inputRefs" },
            "expectedOutputs": {
              "$ref": "work-unit.schema.json#/properties/expectedOutputs"
            },
            "status": { "const": "VERIFYING" },
            "attempt": { "type": "integer", "minimum": 1 }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/artifactProjection" }
        },
        "evaluationPolicy": {
          "$ref": "verification-evaluation-policy.schema.json"
        }
      }
    },
    "artifactProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "attempt", "kind", "digest", "contentAddress", "mediaType",
        "sizeBytes", "sensitivity"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "attempt": { "type": "integer", "minimum": 1 },
        "kind": { "$ref": "artifact.schema.json#/properties/kind" },
        "digest": { "$ref": "artifact.schema.json#/properties/digest" },
        "contentAddress": {
          "$ref": "artifact.schema.json#/properties/contentAddress"
        },
        "mediaType": { "$ref": "artifact.schema.json#/properties/mediaType" },
        "sizeBytes": { "$ref": "artifact.schema.json#/properties/sizeBytes" },
        "sourceRepository": {
          "$ref": "artifact.schema.json#/properties/sourceRepository"
        },
        "baseCommit": { "$ref": "artifact.schema.json#/properties/baseCommit" },
        "sensitivity": { "$ref": "artifact.schema.json#/properties/sensitivity" }
      }
    }
  }
}
