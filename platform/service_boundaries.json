{
  "version": 1,
  "goal": "commercial-grade multi-agent platform for 10k online users",
  "languages": {
    "go": "online realtime control plane and connection ingress",
    "rust": "high-performance engine crates for stream, retrieval, fanout, patching, and memory compaction",
    "python": "offline knowledge, document pipeline, adapters, evaluation, summarization"
  },
  "services": [
    {
      "name": "gateway-service",
      "language": "go",
      "runtime_path": "services/go/gateway-service",
      "responsibilities": [
        "http api ingress",
        "websocket gateway",
        "sse fallback",
        "jwt verification",
        "tenant-aware rate limiting",
        "connection registry",
        "heartbeat and reconnect"
      ],
      "depends_on": ["redis", "nats", "session-service", "stream-delivery-service"],
      "extracts_from_current": ["app/api/websocket.py", "app/services/websocket_manager.py", "app/api/auth.py"]
    },
    {
      "name": "realtime-orchestrator",
      "language": "go",
      "runtime_path": "services/go/realtime-orchestrator",
      "responsibilities": [
        "react loop coordination",
        "conversation state machine",
        "agent scheduling",
        "deepsearch request orchestration",
        "tool approval workflow",
        "stream lifecycle management"
      ],
      "depends_on": ["nats", "redis", "postgresql", "agent-runtime-control-plane", "tool-permission-service"],
      "extracts_from_current": ["app/services/message_router.py", "app/services/task_state_machine.py", "app/services/langgraph_workflow.py", "app/services/orchestrator_preprocessor.py"]
    },
    {
      "name": "session-service",
      "language": "go",
      "runtime_path": "services/go/session-service",
      "responsibilities": [
        "session metadata api",
        "presence state",
        "reconnect cursors",
        "message checkpointing",
        "session authorization view"
      ],
      "depends_on": ["postgresql", "redis"],
      "extracts_from_current": ["app/api/chat.py", "app/api/user.py", "app/services/auth/session_guard.py"]
    },
    {
      "name": "tool-permission-service",
      "language": "go",
      "runtime_path": "services/go/tool-permission-service",
      "responsibilities": [
        "permission request state",
        "decision timeout handling",
        "sensitive tool policy evaluation",
        "audit event emission"
      ],
      "depends_on": ["redis", "nats", "postgresql"],
      "extracts_from_current": ["app/api/websocket.py", "app/services/tools/permission.py", "app/services/guardrails.py"]
    },
    {
      "name": "agent-runtime-control-plane",
      "language": "go",
      "runtime_path": "services/go/agent-runtime-control-plane",
      "responsibilities": [
        "dispatch model invocations",
        "dispatch tool tasks",
        "worker lease management",
        "runtime budget enforcement",
        "agent concurrency control"
      ],
      "depends_on": ["nats", "redis", "postgresql", "python-workers"],
      "extracts_from_current": ["app/services/agent_service.py", "app/services/tool_executor.py", "app/services/adapter_manager.py"]
    },
    {
      "name": "stream-delivery-service",
      "language": "go",
      "runtime_path": "services/go/stream-delivery-service",
      "responsibilities": [
        "deliver aggregated chunks",
        "session fanout control",
        "replay recent chunks",
        "slow client downgrade coordination"
      ],
      "depends_on": ["redis", "nats", "stream-core", "fanout-core"],
      "extracts_from_current": ["app/services/websocket_manager.py", "app/api/websocket.py"]
    },
    {
      "name": "stream-core",
      "language": "rust",
      "runtime_path": "services/rust/crates/stream-core",
      "responsibilities": [
        "chunk coalescing",
        "backpressure windows",
        "flush policy",
        "slow consumer downgrade"
      ]
    },
    {
      "name": "retrieval-core",
      "language": "rust",
      "runtime_path": "services/rust/crates/retrieval-core",
      "responsibilities": [
        "hybrid retrieval fusion",
        "rerank score merge",
        "evidence deduplication",
        "citation-ready result shaping"
      ]
    },
    {
      "name": "fanout-core",
      "language": "rust",
      "runtime_path": "services/rust/crates/fanout-core",
      "responsibilities": [
        "high-cardinality event fanout",
        "channel partitioning",
        "broadcast scheduling"
      ]
    },
    {
      "name": "patch-merge-core",
      "language": "rust",
      "runtime_path": "services/rust/crates/patch-merge-core",
      "responsibilities": [
        "diff/patch apply",
        "merge conflict scoring",
        "artifact delta compaction"
      ]
    },
    {
      "name": "memory-segment-core",
      "language": "rust",
      "runtime_path": "services/rust/crates/memory-segment-core",
      "responsibilities": [
        "message segment compaction",
        "memory window pruning",
        "summary checkpoint assist"
      ]
    },
    {
      "name": "offline-knowledge-service",
      "language": "python",
      "runtime_path": "services/python/offline_knowledge_service",
      "responsibilities": [
        "knowledge ingestion",
        "chunking",
        "embedding generation",
        "vector upsert pipelines"
      ],
      "extracts_from_current": ["app/services/memory/*", "app/api/memory.py", "app/services/text_processing.py"]
    },
    {
      "name": "document-pipeline-service",
      "language": "python",
      "runtime_path": "services/python/document_pipeline_service",
      "responsibilities": [
        "pdf/docx/ppt/image extraction",
        "preview artifact generation",
        "content sanitization"
      ],
      "extracts_from_current": ["app/api/files.py", "app/services/text_processing.py"]
    },
    {
      "name": "model-adapter-service",
      "language": "python",
      "runtime_path": "services/python/model_adapter_service",
      "responsibilities": [
        "provider adapters",
        "offline model benchmarking",
        "batch embedding and rerank inference"
      ],
      "extracts_from_current": ["app/services/adapters/*", "app/services/protocols/*"]
    },
    {
      "name": "evaluation-batch-service",
      "language": "python",
      "runtime_path": "services/python/evaluation_batch_service",
      "responsibilities": [
        "regression evaluation",
        "quality scoring",
        "load test replay analysis"
      ]
    },
    {
      "name": "summarization-service",
      "language": "python",
      "runtime_path": "services/python/summarization_service",
      "responsibilities": [
        "offline consolidation",
        "session summarization",
        "report generation",
        "memory checkpoint writing"
      ],
      "extracts_from_current": ["app/services/memory/consolidator.py", "app/services/result_synthesizer.py"]
    }
  ]
}