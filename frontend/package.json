{
  "name": "agenthub-frontend",
  "version": "3.0.0-runnable",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const copies=[['node_modules/pdfjs-dist/build/pdf.min.mjs','public/pdf.min.mjs'],['node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs']];try{fs.mkdirSync('public',{recursive:true});for(const [src,dst] of copies){fs.copyFileSync(path.join(...src.split('/')),path.join(...dst.split('/')));}console.log('copied pdfjs runtime to public/');}catch(e){console.warn('pdfjs runtime copy skipped:',e.message);}\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.11.3",
    "@xyflow/react": "^12.10.0",
    "framer-motion": "^12.42.2",
    "konva": "^9.3.18",
    "lucide-react": "^1.16.0",
    "next": "^14.2.15",
    "pdfjs-dist": "^4.0.379",
    "pixi.js": "^8.19.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.15",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "critters": "^0.0.23",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.4.0",
    "vitest": "^4.1.9"
  }
}
