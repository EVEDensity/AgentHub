{
  "name": "agenthub-frontend",
  "version": "3.0.0-runnable",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('node_modules','pdfjs-dist','build','pdf.worker.min.mjs');const dst=path.join('public','pdf.worker.min.mjs');try{fs.mkdirSync('public',{recursive:true});fs.copyFileSync(src,dst);console.log('copied pdf worker to public/');}catch(e){console.warn('pdf worker copy skipped:',e.message);}\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.11.3",
    "konva": "^9.3.18",
    "lucide-react": "^1.16.0",
    "next": "^13.5.7",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^13.5.7",
    "@types/node": "25.8.0",
    "@types/react": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.19",
    "critters": "^0.0.23",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "6.0.3"
  }
}
